  out=$(sync_tree) || return 1
  clone=$(head -1 <<<"$out")
  git -C "$clone" push -q origin HEAD:main || return 1
  rm -rf "$clone" || return 1
  refs=$(git -C "$template" for-each-ref) || return 1
