}
sync_first() {
  sync_fixture sync-first || return 1
  local out clone branch sha
  out=$(sync_tree) || return 1
  clone=$(head -1 <<<"$out")
  branch=$(tail -1 <<<"$out")
  sha=$(git -C "$repo" rev-parse --short HEAD) || return 1
