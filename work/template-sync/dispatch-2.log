/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
import subprocess
p = Path('scripts/sync-template.sh')
original = p.read_text()
mutations = [
 ('regex-tag', 'grep -Fqx \"v"'$version"'"', 'grep -qx \"v"'$version"'"', 'sync (c)'),
 ('no-op-cleanup', '  rm -rf \""'$clone" || error '"\\'cannot delete up-to-date clone\\'', '  : # mutation: omit no-op clone cleanup', 'sync (b)'),
 ('export-trap', 'trap \\'rm -rf \""'$exp"'"\\' EXIT', ': # mutation: omit export trap', 'sync (b)'),
]
try:
 for name, old, new, case in mutations:
  assert original.count(old) == 1
  p.write_text(original.replace(old, new))
  landed = p.read_text()
  assert old not in landed and new in landed
  print(f'{name}: landed (old absent, replacement present)', flush=True)
  result = subprocess.run(['bash', 'tests/test-export.sh'], capture_output=True, text=True)
  Path('/tmp/template-sync-' + name + '.log').write_text(result.stdout + result.stderr)
  failures = [line for line in result.stdout.splitlines() if line.startswith('FAIL:')]
  print(f'exit={result.returncode}; ' + '; '.join(failures), flush=True)
  assert result.returncode == 1 and any(case in line for line in failures)
  p.write_text(original)
finally:
 p.write_text(original)
assert p.read_text() == original
print('All three mutations restored.')
PY" in /Users/cboyfly/Documents/repos/agentic-coding-worktrees/template-sync
