  [ \"\$(cat '$FAN_WTS/demo/branch.txt')\" = 'wt/demo-fan-3' ] &&
  ! git show-ref --verify --quiet refs/heads/wt/demo-fan-1 &&
  ! git show-ref --verify --quiet refs/heads/wt/demo-fan-2 &&
